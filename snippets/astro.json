{
  "Astro component scaffold": {
    "prefix": "astro",
    "body": [
      "---",
      "$0",
      "---",
      "",
      "<div>",
      "  ",
      "</div>"
    ],
    "description": "Astro component with frontmatter and markup"
  },
  "Frontmatter fence": {
    "prefix": "fm",
    "body": ["---", "$0", "---"],
    "description": "Astro frontmatter code fence"
  },
  "Import component": {
    "prefix": "imp",
    "body": ["import ${1:Component} from '${2:../components/${1:Component}.astro}';$0"],
    "description": "Import an Astro/framework component"
  },
  "Define Props interface": {
    "prefix": "props",
    "body": [
      "interface Props {",
      "  ${1:title}: ${2:string};",
      "}",
      "",
      "const { ${1:title} } = Astro.props;$0"
    ],
    "description": "Typed Props interface + destructure from Astro.props"
  },
  "Astro.props destructure": {
    "prefix": "aprops",
    "body": ["const { $1 } = Astro.props;$0"],
    "description": "Destructure Astro.props"
  },
  "getStaticPaths": {
    "prefix": "gsp",
    "body": [
      "export async function getStaticPaths() {",
      "  return [",
      "    { params: { ${1:slug}: ${2:'value'} } },$0",
      "  ];",
      "}"
    ],
    "description": "getStaticPaths for dynamic routes"
  },
  "Map over list": {
    "prefix": "map",
    "body": [
      "{${1:items}.map((${2:item}) => (",
      "  <${3:li}>{${2:item}}</${3:li}>",
      "))}$0"
    ],
    "description": "Render a list with .map in markup"
  },
  "Conditional render": {
    "prefix": "if",
    "body": ["{${1:condition} && (", "  $0", ")}"],
    "description": "Conditional render in markup"
  },
  "Client directive": {
    "prefix": "client",
    "body": ["client:${1|load,idle,visible,media,only|}"],
    "description": "Astro client hydration directive"
  },
  "set:html": {
    "prefix": "sethtml",
    "body": ["set:html={${1:content}}$0"],
    "description": "Inject raw HTML"
  },
  "Slot": {
    "prefix": "slot",
    "body": ["<slot${1: name=\"${2:name}\"} />$0"],
    "description": "Astro slot"
  }
}
